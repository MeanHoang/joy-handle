# Joy Agent — copy to .env.agent and fill in your credentials
# Auto-loaded by joy-debug scripts. Already gitignored (.env* pattern).
# Each developer sets up their own credentials.

# === GCP Cloud Logging (required for log queries) ===
GOOGLE_APPLICATION_CREDENTIALS=joy-handle/serviceAccount.support.json
GCP_PROJECT=avada-joy

# === Crisp (for reading support chats) ===
CRISP_IDENTIFIER=
CRISP_APP_KEY=

# === Slack (for reading threads) ===
SLACK_TOKEN=

# === Notion (for creating bug tasks) ===
NOTION_API_KEY=
